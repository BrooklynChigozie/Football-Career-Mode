/* Dark theme: one accent colour (green), consistent spacing. Change colours here only. */
* { font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif; font-size: 14px; color: #e6e9ef; }
QMainWindow, QWidget#root, QStackedWidget { background: #0f1218; }
QWidget#content { background: #0f1218; }

/* Sidebar */
QFrame#sidebar { background: #161a22; border-right: 1px solid #232937; }
QLabel#brand { font-size: 18px; font-weight: 700; color: #ffffff; padding: 4px 8px 16px 8px; }
QPushButton#navButton {
    text-align: left; padding: 10px 14px; border: none; border-radius: 8px;
    background: transparent; color: #a9b1c1;
}
QPushButton#navButton:hover { background: #1e2431; color: #ffffff; }
QPushButton#navButton:checked { background: #1f3a2c; color: #3ddc84; font-weight: 600; }
QPushButton#navButton:disabled { color: #4a5262; }
QLabel#userLabel { color: #a9b1c1; padding: 0 8px; }

/* Typography */
QLabel#pageTitle { font-size: 24px; font-weight: 700; color: #ffffff; }
QLabel#pageSubtitle { color: #8b94a7; }
QLabel#muted { color: #8b94a7; }
QLabel#error { color: #ff6b6b; }
QLabel#success { color: #3ddc84; }

/* Cards */
QFrame#card { background: #161a22; border: 1px solid #232937; border-radius: 12px; }
QLabel#cardTitle { color: #8b94a7; font-size: 12px; text-transform: uppercase; }
QLabel#cardValue { font-size: 26px; font-weight: 700; color: #ffffff; }
QLabel#cardNote { color: #8b94a7; font-size: 12px; }

/* Inputs */
QLineEdit {
    background: #0f1218; border: 1px solid #2a3142; border-radius: 8px; padding: 10px 12px;
    selection-background-color: #3ddc84; selection-color: #0f1218;
}
QLineEdit:focus { border: 1px solid #3ddc84; }

/* Buttons */
QPushButton { background: #232937; border: none; border-radius: 8px; padding: 10px 16px; }
QPushButton:hover { background: #2c3446; }
QPushButton#primary { background: #3ddc84; color: #0b0f14; font-weight: 700; }
QPushButton#primary:hover { background: #5be79b; }
QPushButton#primary:disabled { background: #2a3b32; color: #6b7a72; }
QPushButton#link { background: transparent; color: #3ddc84; padding: 4px; }
QPushButton#link:hover { text-decoration: underline; }

/* Login */
QFrame#loginCard { background: #161a22; border: 1px solid #232937; border-radius: 16px; }
QLabel#loginTitle { font-size: 26px; font-weight: 700; color: #ffffff; }

QProgressBar { background: #232937; border: none; border-radius: 4px; height: 8px; text-align: center; }
QProgressBar::chunk { background: #3ddc84; border-radius: 4px; }
QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical { background: #2a3142; border-radius: 5px; min-height: 24px; }
